<Window x:Class="WuMgr.Wpf.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{Binding Title}" Width="1280" Height="860" MinWidth="1024" MinHeight="680"
 WindowStartupLocation="CenterScreen" Background="{DynamicResource WarmCanvas}"
 FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True"
 Closing="Window_Closing">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/WuMgr.Wpf;component/Themes/Modern.xaml" />
   </ResourceDictionary.MergedDictionaries>
   <BooleanToVisibilityConverter x:Key="BoolVisibility" />
   <Style x:Key="NavigationItem" TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="Foreground" Value="#D7E3DE" />
    <Setter Property="Template"><Setter.Value>
     <ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="NavBorder" CornerRadius="7" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
       <ContentPresenter />
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#326053" /><Setter Property="Foreground" Value="White" /></Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#295348" /></Trigger>
       <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="NavBorder" Property="BorderBrush" Value="#99CDB8" /></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value></Setter>
   </Style>
   <DataTemplate x:Key="VersionTemplate">
    <Grid Margin="8,6">
     <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="{Binding Version}" FontWeight="SemiBold" /><TextBlock Text="{Binding Date}" FontSize="11" Foreground="{DynamicResource Muted}" /></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" /><TextBlock Text="{Binding Provider}" FontSize="11" Foreground="{DynamicResource Muted}" /></StackPanel>
    </Grid>
   </DataTemplate>
   <DataTemplate x:Key="DeviceTemplate">
    <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,8,10">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding Manufacturer}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0" /></StackPanel>
       <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" AutomationProperties.Name="{Binding Name}" ToolTip="{Binding VersionSummary}">
        <TextBlock Text="{Binding DataContext[SelectionLabel], RelativeSource={RelativeSource AncestorType=Window}}" />
       </CheckBox>
      </Grid>
      <Grid Grid.Row="1" Margin="0,14,0,10">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding DataContext[Installed], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource Muted}" FontSize="11" /><TextBlock Text="{Binding InstalledVersion}" FontWeight="SemiBold" /></StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="{Binding DataContext[Candidate], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource Muted}" FontSize="11" /><TextBlock Text="{Binding VersionSummary}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" /></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="{Binding InstalledDate}" Foreground="{DynamicResource Muted}" FontSize="11" /><TextBlock Text="{Binding InstalledProvider}" /></StackPanel>
      </Grid>
      <Grid Grid.Row="2">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" Margin="0,0,12,0" />
       <WrapPanel Grid.Column="1" VerticalAlignment="Center">
        <Button Content="{Binding DataContext[Details], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DetailsCommand}" Style="{StaticResource SecondaryButton}" Padding="10,5" />
        <CheckBox Content="{Binding DataContext[Versions], RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding IsExpanded}" IsEnabled="{Binding HasCandidates}" Margin="12,0,0,0" VerticalAlignment="Center" />
       </WrapPanel>
      </Grid>
      <Border Grid.Row="3" Margin="0,12,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolVisibility}}" Background="#F8F8F6" CornerRadius="7" Padding="4">
       <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}" ItemTemplate="{StaticResource VersionTemplate}" MaxHeight="240" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="{Binding DataContext[Versions], RelativeSource={RelativeSource AncestorType=Window}}" />
      </Border>
     </Grid>
    </Border>
   </DataTemplate>
  </ResourceDictionary>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource InkGreen}">
   <Grid Margin="16,24,16,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="10,0,0,22"><TextBlock Text="WuMgr" Foreground="White" FontSize="26" FontWeight="Bold" /><TextBlock Text="{Binding [Workspace]}" Foreground="#AFC5BD" FontSize="12" Margin="0,5,0,0" /><TextBlock Text="WPF · PREVIEW" Foreground="#8FAEA4" FontSize="10" Margin="0,9,0,0" /></StackPanel>
    <ListBox Grid.Row="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavigationItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="{Binding [DeviceSearch]}">
     <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="2" Margin="0,16,0,0">
     <TextBlock Text="{Binding [Protection]}" Foreground="#AFC5BD" FontSize="11" Margin="6,0,0,6" />
     <TextBlock Text="{Binding PolicyText}" Foreground="#BDD0C9" FontSize="11" MaxHeight="52" TextTrimming="CharacterEllipsis" ToolTip="{Binding PolicyText}" Margin="6,0,0,8" />
     <Button Content="{Binding [PolicyEnable]}" Command="{Binding EnablePolicyCommand}" Style="{StaticResource SecondaryButton}" Padding="7,6" Margin="0,0,0,5" />
     <Button Content="{Binding [PolicyRestore]}" Command="{Binding RestorePolicyCommand}" Style="{StaticResource SecondaryButton}" Padding="7,6" Margin="0,0,0,12" />
     <Button Content="{Binding [Language]}" Command="{Binding ToggleLanguageCommand}" Style="{StaticResource SecondaryButton}" Padding="8,6" />
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="24,20,20,16">
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding [Workspace]}" FontSize="25" FontWeight="Bold" /><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" /></StackPanel>
    <WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="{Binding [Scan]}" Command="{Binding ScanCommand}" /><Button Content="{Binding [RefreshDevices]}" Command="{Binding RefreshDevicesCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" /></WrapPanel>
    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding StatusText}" Foreground="{DynamicResource Muted}" MaxHeight="38" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" Margin="0,8,0,0" />
   </Grid>
   <Grid Grid.Row="1" Margin="0,14,0,10">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="10,1">
     <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=180}" BorderThickness="0" Background="Transparent" Padding="3,8" ToolTip="{Binding [SearchHint]}" AutomationProperties.Name="{Binding [SearchHint]}" />
    </Border>
    <WrapPanel Grid.Row="1" Margin="0,8,0,0">
     <CheckBox IsChecked="{Binding IncludeHistory}" IsEnabled="{Binding IsIdle}" Content="{Binding [History]}" Margin="0,3,14,3" VerticalAlignment="Center" />
     <Button Content="{Binding [AutoSelect]}" Command="{Binding AutoSelectCommand}" Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="0,2,8,2" />
     <Button Content="{Binding [ClearSelection]}" Command="{Binding ClearSelectionCommand}" Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="0,2,0,2" />
    </WrapPanel>
   </Grid>
   <Border Grid.Row="2" Visibility="{Binding IsDemo, Converter={StaticResource BoolVisibility}}" Background="#E7EFE8" CornerRadius="7" Padding="10,8" Margin="0,0,0,10">
    <TextBlock Text="{Binding [DemoNotice]}" Foreground="#245148" FontSize="12" />
   </Border>
   <Grid Grid.Row="3">
    <ListBox ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource DeviceTemplate}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" KeyboardNavigation.TabNavigation="Local" AutomationProperties.Name="{Binding [CommonDevices]}" />
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480" IsHitTestVisible="False">
     <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Devices.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <TextBlock Text="{Binding [EmptyTitle]}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
     <TextBlock Text="{Binding [EmptyBody]}" Foreground="{DynamicResource Muted}" TextAlignment="Center" Margin="0,8,0,0" />
    </StackPanel>
   </Grid>
   <Border Grid.Row="4" Background="White" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,10,0,0">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding [DownloadFolderLabel]}" Foreground="{DynamicResource Muted}" FontSize="11" /><TextBox Text="{Binding DownloadFolder, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding IsIdle}" MinHeight="26" BorderThickness="0" Padding="0,3" ToolTip="{Binding DownloadFolder}" AutomationProperties.Name="{Binding [DownloadFolderLabel]}" /></StackPanel>
      <Button Grid.Column="1" Content="{Binding [Browse]}" Command="{Binding BrowseCommand}" Style="{StaticResource SecondaryButton}" Padding="10,6" VerticalAlignment="Center" />
      <Button Grid.Column="2" Content="{Binding [OpenFolder]}" Command="{Binding OpenFolderCommand}" Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="6,0,0,0" VerticalAlignment="Center" />
     </Grid>
     <Grid Grid.Row="1" Margin="0,8,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <CheckBox IsChecked="{Binding InstallAfterDownload}" IsEnabled="{Binding IsIdle}" Content="{Binding [Install]}" VerticalAlignment="Center" Margin="0,0,12,0" />
      <Button Grid.Column="1" Content="{Binding [Cancel]}" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
      <Button Grid.Column="2" Content="{Binding [Download]}" Command="{Binding DownloadCommand}" MinWidth="100" />
     </Grid>
     <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ProgressBar Height="6" Value="{Binding ProgressValue}" Maximum="100" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding ProgressText}" Foreground="{DynamicResource Muted}" FontSize="11" MaxHeight="32" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" ToolTip="{Binding ProgressText}" /></Grid>
     <Expander Grid.Row="3" Header="{Binding [Log]}" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"><TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" MaxHeight="80" /></Expander>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>
