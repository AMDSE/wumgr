<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>WuMgr.Wpf</AssemblyName>
    <RootNamespace>WuMgr.Wpf</RootNamespace>
    <Version>11.0.0-preview.2</Version>
    <ApplicationIcon>../wumgr/wu.ico</ApplicationIcon>
    <ApplicationManifest>../wumgr/app.manifest</ApplicationManifest>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WuMgr.Core/WuMgr.Core.csproj" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Compile Include="../wumgr/UiStrings.cs" Link="Services/LegacyTranslations.cs" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Management" />
  </ItemGroup>
</Project>
