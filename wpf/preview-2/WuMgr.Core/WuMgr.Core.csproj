<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>WuMgr.Core</AssemblyName>
    <RootNamespace>wumgr</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>11.0.0-preview.2</Version>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Downloader" Version="3.1.2" />
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
    <Compile Include="../wumgr/DriverInfo.cs" Link="DriverInfo.cs" />
    <Compile Include="../wumgr/DriverCatalog.cs" Link="DriverCatalog.cs" />
    <Compile Include="../wumgr/DriverDownloader.cs" Link="DriverDownloader.cs" />
    <Compile Include="../wumgr/DriverService.cs" Link="DriverService.cs" />
    <Compile Include="../wumgr/DriverInstaller.cs" Link="DriverInstaller.cs" />
    <Compile Include="../wumgr/DriverUpdatePolicy.cs" Link="DriverUpdatePolicy.cs" />
    <Compile Include="../wumgr/DeviceDiscovery.cs" Link="DeviceDiscovery.cs" />
    <Compile Include="../wumgr/SetupApiDeviceSource.cs" Link="SetupApiDeviceSource.cs" />
    <Compile Include="../wumgr/DeviceInventory.cs" Link="DeviceInventory.cs" />
  </ItemGroup>
</Project>
